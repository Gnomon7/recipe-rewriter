# Port the local server listens on. If you change this, also update
# host_permissions in extension/manifest.json and API_BASE in extension/background.js
PORT=5757

# Which engine rewrites instructions to inline ingredient measurements: "claude" or "local"
REWRITE_ENGINE=claude

# Required only when REWRITE_ENGINE=claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
