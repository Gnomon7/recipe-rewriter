{
  "manifest_version": 3,
  "name": "Recipe Book Capture",
  "version": "1.0.0",
  "description": "Send the recipe on this page to your local Recipe Book.",
  "action": {
    "default_title": "Save recipe to Recipe Book"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "notifications", "tabs"],
  "host_permissions": ["http://localhost:5757/*"]
}
